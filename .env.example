# Server-side only. Never commit real values. Copy to api/.env.
# LLM provider: anthropic (Messages API) or gateway (Vercel AI Gateway, OpenAI-compatible)
LLM_PROVIDER=gateway
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# Hard cap on model spend per run, in USD
CANONICO_COST_CAP_USD=2.00
# Comma-separated origins allowed by CORS, plus a regex for preview domains
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Set to 1 to start in offline mode: no live model calls, cached and deterministic results only
CANONICO_OFFLINE=
# Optional overrides of the model ids
CANONICO_MODEL_EXTRACTION=
CANONICO_MODEL_CLASSIFICATION=
CANONICO_MODEL_ANSWER=
