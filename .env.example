# Server-side only. Never commit real values. Copy to api/.env.
# LLM provider: anthropic (Messages API, the default) or gateway (Vercel AI Gateway, OpenAI-compatible).
# Both keys can be set at the same time; LLM_PROVIDER picks the one in use. Restart after changing it.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# Hard cap on model spend per run, in USD
CANONICO_COST_CAP_USD=2.00
# Comma-separated origins allowed by CORS, plus a regex for preview domains
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Set to 1 to start in offline mode: no live model calls, cached and deterministic results only
CANONICO_OFFLINE=
# Optional model ids for the selected provider. Defaults: claude-haiku-5-5 and claude-sonnet-5-5 on anthropic,
# anthropic/claude-haiku-5.5 and anthropic/claude-sonnet-5.5 on gateway (https://ai-gateway.vercel.sh/v1)
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# Per-role overrides, they win over the two above
CANONICO_MODEL_EXTRACTION=
CANONICO_MODEL_CLASSIFICATION=
CANONICO_MODEL_ANSWER=
# Topic routing for free questions: model (default when a provider is configured) or lexical
CANONICO_ROUTER=
# Base URL shown in webhook addresses
CANONICO_PUBLIC_URL=http://localhost:8000
# Set to 1 only on a closed network: lets file_url point to private addresses
CANONICO_ALLOW_PRIVATE_FETCH=
